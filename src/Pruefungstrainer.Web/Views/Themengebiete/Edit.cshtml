@model Themengebiet

@{
    ViewData["Title"] = "Themengebiet bearbeiten";
}

<h1>Themengebiet bearbeiten</h1>

<div class="row">
    <div class="col-md-6">
        <form asp-action="Edit" asp-route-id="@Model.Id" method="post">
            <input type="hidden" asp-for="Id" />
            <partial name="_Formular" model="Model" />
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
