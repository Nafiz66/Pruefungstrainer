@model IEnumerable<Themengebiet>

@{
    ViewData["Title"] = "Themengebiete";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1>Themengebiete</h1>
    <a class="btn btn-primary" asp-action="Create">Neues Themengebiet</a>
</div>

@if (!Model.Any())
{
    <div class="alert alert-info">Es sind noch keine Themengebiete vorhanden.</div>
}
else
{
    <table class="table table-striped align-middle">
        <thead>
            <tr>
                <th>Name</th>
                <th>Kategorie</th>
                <th>Beschreibung</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var themengebiet in Model)
            {
                <tr>
                    <td>@themengebiet.Name</td>
                    <td>@themengebiet.Kategorie</td>
                    <td>@themengebiet.Beschreibung</td>
                    <td class="text-end text-nowrap">
                        <a class="btn btn-sm btn-outline-secondary" asp-controller="Fragen" asp-action="Index" asp-route-themengebietId="@themengebiet.Id">Fragen</a>
                        <a class="btn btn-sm btn-outline-secondary" asp-controller="Karteikarten" asp-action="Index" asp-route-themengebietId="@themengebiet.Id">Karteikarten</a>
                        <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@themengebiet.Id">Bearbeiten</a>
                        <form asp-action="Delete" asp-route-id="@themengebiet.Id" method="post" class="d-inline"
                              data-bestaetigen="Themengebiet '@themengebiet.Name' wirklich löschen?">
                            <button type="submit" class="btn btn-sm btn-outline-danger">Löschen</button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
