@model IEnumerable<Themengebiet>

@{
    ViewData["Title"] = "Themengebiete";
}

<h1>Themengebiete</h1>

@if (!Model.Any())
{
    <div class="alert alert-info">Es sind noch keine Themengebiete vorhanden.</div>
}
else
{
    <table class="table table-striped">
        <thead>
            <tr>
                <th>Name</th>
                <th>Kategorie</th>
                <th>Beschreibung</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var themengebiet in Model)
            {
                <tr>
                    <td>@themengebiet.Name</td>
                    <td>@themengebiet.Kategorie</td>
                    <td>@themengebiet.Beschreibung</td>
                </tr>
            }
        </tbody>
    </table>
}
