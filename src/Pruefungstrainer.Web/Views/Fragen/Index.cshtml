@model IEnumerable<Frage>

@{
    ViewData["Title"] = "Prüfungsfragen";
}

<div class="container mt-4">
    <h2>Prüfungsfragen-Übersicht</h2>
    <p class="text-muted">Hier siehst du alle aktuell in der SQLite-Datenbank hinterlegten Fragen.</p>

    <hr />

    @if (Model == null || !Model.Any())
    {
        <div class="alert alert-warning" role="alert">
            Keine Fragen gefunden. Die Datenbank enthält noch keine Fragen.
        </div>
    }
    else
    {
        <table class="table table-striped table-bordered">
            <thead class="table-dark">
                <tr>
                    <th>ID</th>
                    <th>Fragetext</th>
                    <th>Punkte</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var frage in Model)
                {
                    <tr>
                        <td>@frage.Id</td>
                        <td>@frage.Fragetext</td>
                        <td>@frage.Punkte</td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>