@model IEnumerable<Lernpfad>

@{
    ViewData["Title"] = "Lernpfade";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1>Lernpfade</h1>
    <a class="btn btn-primary" asp-action="Create">Neuer Lernpfad</a>
</div>

@if (!Model.Any())
{
    <div class="alert alert-info">Es sind noch keine Lernpfade vorhanden.</div>
}
else
{
    <table class="table table-striped align-middle">
        <thead>
            <tr>
                <th>Titel</th>
                <th>Themengebiet</th>
                <th>Elemente</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var lernpfad in Model)
            {
                <tr>
                    <td>
                        @lernpfad.Titel
                        @if (!string.IsNullOrWhiteSpace(lernpfad.Beschreibung))
                        {
                            <div class="small text-muted">@lernpfad.Beschreibung</div>
                        }
                    </td>
                    <td>@lernpfad.Themengebiet.Name</td>
                    <td>@lernpfad.Elemente.Count</td>
                    <td class="text-end text-nowrap">
                        <a class="btn btn-sm btn-outline-secondary" asp-action="Elemente" asp-route-id="@lernpfad.Id">Inhalte</a>
                        <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@lernpfad.Id">Bearbeiten</a>
                        <form asp-action="Delete" asp-route-id="@lernpfad.Id" method="post" class="d-inline"
                              data-bestaetigen="Lernpfad '@lernpfad.Titel' wirklich löschen?">
                            <button type="submit" class="btn btn-sm btn-outline-danger">Löschen</button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
