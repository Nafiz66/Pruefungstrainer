@model BenutzerFormViewModel
@{
    ViewData["Title"] = "Benutzer anlegen";
}

<h1>Benutzer anlegen</h1>

<div class="row">
    <div class="col-md-6">
        <form asp-action="Create" method="post">
            <partial name="_BenutzerFelder" model="Model" />

            <div class="mb-3">
                <label asp-for="Rolle" class="form-label"></label>
                <select asp-for="Rolle" class="form-select">
                    <option value="@UserRole.Teilnehmer">Teilnehmer</option>
                    <option value="@UserRole.Lehrkraft">Lehrkraft</option>
                </select>
            </div>

            <button type="submit" class="btn btn-primary">Speichern</button>
            <a asp-action="Index" class="btn btn-secondary">Abbrechen</a>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
