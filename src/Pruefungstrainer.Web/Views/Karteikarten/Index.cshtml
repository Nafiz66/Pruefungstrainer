@model IEnumerable<Karteikarte>

@{
    ViewData["Title"] = "Karteikarten";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1>Karteikarten</h1>
    <a class="btn btn-primary" asp-action="Create" asp-route-themengebietId="@ViewData["ThemengebietId"]">Neue Karteikarte</a>
</div>

<partial name="_ThemengebietFilter" />

@if (!Model.Any())
{
    <div class="alert alert-info">Keine Karteikarten gefunden.</div>
}
else
{
    <table class="table table-striped align-middle">
        <thead>
            <tr>
                <th>Vorderseite (Frage)</th>
                <th>Rückseite (Antwort)</th>
                <th>Themengebiet</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var karte in Model)
            {
                <tr>
                    <td>@karte.Frage</td>
                    <td>@karte.Antwort</td>
                    <td>@karte.Themengebiet.Name</td>
                    <td class="text-end text-nowrap">
                        <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@karte.Id">Bearbeiten</a>
                        <form asp-action="Delete" asp-route-id="@karte.Id" method="post" class="d-inline"
                              data-bestaetigen="Diese Karteikarte wirklich löschen? Der Lernfortschritt der Teilnehmer dazu geht verloren.">
                            <button type="submit" class="btn btn-sm btn-outline-danger">Löschen</button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
