<!DOCTYPE html>
<html lang="de">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Prüfungstrainer</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Pruefungstrainer.Web.styles.css" asp-append-version="true" />
</head>
<body>
    @{
        var istLehrkraft = User.IsInRole(nameof(UserRole.Lehrkraft));
        var istAngemeldet = User.Identity?.IsAuthenticated == true;
    }
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">
            <div class="container">
                <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">Prüfungstrainer</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Navigation umschalten">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        @if (istAngemeldet)
                        {
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-controller="Lernen" asp-action="Index">Lernen</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-controller="Quiz" asp-action="Verlauf">Meine Ergebnisse</a>
                            </li>
                        }
                        @if (istLehrkraft)
                        {
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle text-dark" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">Verwaltung</a>
                                <ul class="dropdown-menu">
                                    <li><a class="dropdown-item" asp-controller="Themengebiete" asp-action="Index">Themengebiete</a></li>
                                    <li><a class="dropdown-item" asp-controller="Fragen" asp-action="Index">Fragen</a></li>
                                    <li><a class="dropdown-item" asp-controller="Karteikarten" asp-action="Index">Karteikarten</a></li>
                                    <li><a class="dropdown-item" asp-controller="Lernpfade" asp-action="Index">Lernpfade</a></li>
                                    <li><hr class="dropdown-divider" /></li>
                                    <li><a class="dropdown-item" asp-controller="Benutzer" asp-action="Index">Benutzer</a></li>
                                </ul>
                            </li>
                        }
                    </ul>
                    <ul class="navbar-nav">
                        @if (istAngemeldet)
                        {
                            <li class="nav-item">
                                <span class="navbar-text me-3">
                                    @User.Identity!.Name
                                    <span class="badge bg-secondary">@(istLehrkraft ? "Lehrkraft" : "Teilnehmer")</span>
                                </span>
                            </li>
                            <li class="nav-item">
                                <form asp-controller="Account" asp-action="Logout" method="post">
                                    <button type="submit" class="btn btn-link nav-link text-dark">Abmelden</button>
                                </form>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-controller="Account" asp-action="Login">Anmelden</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-controller="Account" asp-action="Registrieren">Registrieren</a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            <partial name="_Meldungen" />
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2026 - Prüfungstrainer - <a asp-area="" asp-controller="Home" asp-action="Privacy">Datenschutz</a>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
