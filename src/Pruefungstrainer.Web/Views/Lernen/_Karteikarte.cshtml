@model Karteikarte
@* Eine Karteikarte: Vorderseite sichtbar, Rückseite per Klick aufklappbar.
   <details>/<summary> ist reines HTML – funktioniert ohne JavaScript. *@

<div class="card shadow-sm">
    <div class="card-body">
        <p class="small text-muted mb-1">Frage</p>
        <p class="fs-5">@Model.Frage</p>
        <details>
            <summary class="btn btn-sm btn-outline-secondary">Antwort anzeigen</summary>
            <div class="mt-3 p-3 bg-light rounded">@Model.Antwort</div>
        </details>
    </div>
</div>
