@model Lernpfad

@{
    ViewData["Title"] = "Lernpfad abgeschlossen";
    var hatFragen = ViewData["HatFragen"] as bool? == true;
}

<div class="text-center py-4">
    <h1>Lernpfad abgeschlossen 🎉</h1>
    <p class="lead">Du hast alle Schritte von „@Model.Titel“ durchgearbeitet.</p>

    @if (hatFragen)
    {
        <p>Teste jetzt dein Wissen: Der Abschlusstest stellt dir die Fragen dieses Lernpfads. Das Ergebnis wird gespeichert.</p>
        <a class="btn btn-primary btn-lg" asp-controller="Quiz" asp-action="Start" asp-route-lernpfadId="@Model.Id">Abschlusstest starten</a>
    }

    <div class="mt-3">
        <a class="btn btn-outline-secondary" asp-action="Lernpfad" asp-route-id="@Model.Id" asp-route-schritt="1">Nochmal von vorne</a>
        <a class="btn btn-outline-secondary" asp-action="Index">Zum Lernbereich</a>
    </div>
</div>
