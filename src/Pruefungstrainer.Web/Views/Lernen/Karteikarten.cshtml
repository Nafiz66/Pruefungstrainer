@model KarteikartenLernenViewModel

@{
    ViewData["Title"] = "Karteikarten lernen";
    var prozent = Model.Gesamt == 0 ? 0 : Model.Gelernt * 100 / Model.Gesamt;
}

<h1>Karteikarten: @Model.Themengebiet.Name</h1>

<div class="mb-3">
    <div class="d-flex justify-content-between small">
        <span>Fortschritt</span>
        <span>@Model.Gelernt von @Model.Gesamt gelernt</span>
    </div>
    <div class="progress" role="progressbar" aria-valuenow="@prozent" aria-valuemin="0" aria-valuemax="100">
        <div class="progress-bar bg-success" style="width: @prozent%"></div>
    </div>
</div>

@if (Model.Karte is null)
{
    <div class="alert alert-success">
        <strong>Geschafft!</strong> Du hast alle Karteikarten dieses Themengebiets gelernt.
    </div>
    <form asp-action="Zuruecksetzen" method="post" class="d-inline">
        <input type="hidden" name="themengebietId" value="@Model.Themengebiet.Id" />
        <button type="submit" class="btn btn-outline-primary">Alle nochmal wiederholen</button>
    </form>
    <a class="btn btn-secondary" asp-action="Index">Zurück zum Lernbereich</a>
}
else
{
    <partial name="_Karteikarte" model="Model.Karte" />

    <form asp-action="Bewerten" method="post" class="d-flex gap-2 mt-3">
        <input type="hidden" name="karteikarteId" value="@Model.Karte.Id" />
        <input type="hidden" name="themengebietId" value="@Model.Themengebiet.Id" />
        <button type="submit" name="gewusst" value="false" class="btn btn-outline-danger flex-fill">Nicht gewusst</button>
        <button type="submit" name="gewusst" value="true" class="btn btn-success flex-fill">Gewusst</button>
    </form>

    <a class="btn btn-link mt-3" asp-action="Index">Lernen beenden</a>
}
