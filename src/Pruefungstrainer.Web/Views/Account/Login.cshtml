@model LoginViewModel
@{
    ViewData["Title"] = "Anmelden";
}

<div class="row justify-content-center">
    <div class="col-md-5">
        <h1>Anmelden</h1>

        <form asp-action="Login" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="ReturnUrl" />

            <div class="mb-3">
                <label asp-for="Email" class="form-label"></label>
                <input asp-for="Email" class="form-control" autocomplete="username" autofocus />
                <span asp-validation-for="Email" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Passwort" class="form-label"></label>
                <input asp-for="Passwort" class="form-control" autocomplete="current-password" />
                <span asp-validation-for="Passwort" class="text-danger"></span>
            </div>

            <button type="submit" class="btn btn-primary w-100">Anmelden</button>
        </form>

        <p class="mt-3">Noch kein Konto? <a asp-action="Registrieren">Jetzt registrieren</a></p>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
