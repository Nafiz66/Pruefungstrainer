@model BenutzerFormViewModel
@{
    ViewData["Title"] = "Registrieren";
}

<div class="row justify-content-center">
    <div class="col-md-6">
        <h1>Registrieren</h1>
        <p class="text-muted">Du wirst als <strong>Teilnehmer</strong> registriert. Lehrkräfte werden von einer Lehrkraft angelegt.</p>

        <form asp-action="Registrieren" method="post">
            <partial name="_BenutzerFelder" model="Model" />
            <button type="submit" class="btn btn-primary w-100">Konto anlegen</button>
        </form>

        <p class="mt-3">Schon registriert? <a asp-action="Login">Zur Anmeldung</a></p>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
