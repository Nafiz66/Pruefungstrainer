@model QuizDurchfuehrenViewModel

@{
    ViewData["Title"] = Model.Titel;
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1>@Model.Titel</h1>
    @if (Model.EndetUmUtc.HasValue)
    {
        @* Countdown – wird von site.js jede Sekunde aktualisiert und gibt bei 0:00 automatisch ab. *@
        <div class="fs-4">
            ⏱ <span data-endet-um="@Model.EndetUmUtc.Value.ToString("o")" data-formular="quizFormular">--:--</span>
        </div>
    }
</div>

<p class="text-muted">@Model.Fragen.Count Fragen · @Model.Fragen.Sum(f => f.Punkte) Punkte · bestanden ab @IQuizService.BestehensgrenzeProzent %</p>

<form id="quizFormular" asp-action="Abgeben" method="post">
    @for (var i = 0; i < Model.Fragen.Count; i++)
    {
        var frage = Model.Fragen[i];
        <div class="card mb-3">
            <div class="card-body">
                <div class="d-flex justify-content-between">
                    <h2 class="h6">Frage @(i + 1)</h2>
                    <span class="small text-muted">@frage.Themengebiet.Name · @frage.Punkte Punkte</span>
                </div>
                <p class="fs-5">@frage.Fragetext</p>

                @* Der Name "Antworten[i].FrageId" sorgt dafür, dass ASP.NET Core alles in List<QuizAntwortEingabe> bindet. *@
                <input type="hidden" name="antworten[@i].FrageId" value="@frage.Id" />

                @if (frage.Typ == Fragetyp.MultipleChoice)
                {
                    <p class="small text-muted mb-2">Mehrere Antworten können richtig sein.</p>
                    @foreach (var option in frage.Antwortoptionen.OrderBy(a => a.Id))
                    {
                        var feldId = $"f{frage.Id}_o{option.Id}";
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" id="@feldId"
                                   name="antworten[@i].GewaehlteOptionIds" value="@option.Id" />
                            <label class="form-check-label" for="@feldId">@option.Text</label>
                        </div>
                    }
                }
                else
                {
                    <textarea class="form-control" name="antworten[@i].Freitext" rows="3" maxlength="1000"
                              placeholder="Deine Antwort"></textarea>
                }
            </div>
        </div>
    }

    <button type="submit" class="btn btn-primary btn-lg">Abgeben</button>
</form>
